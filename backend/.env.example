# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local development the defaults cover localhost:5173/74/75 automatically.
# Set this for production.
ALLOWED_ORIGINS=https://nautix.io,https://www.nautix.io

# ── Email notification ────────────────────────────────────────────────────────
# All four SMTP values must be set for email delivery to work.
# If any are missing, submissions are saved to backend/logs/failed_submissions.jsonl.

# The address that receives new enquiry notifications (defaults to SMTP_USER if not set).
NOTIFY_EMAIL=enquiries@nautix.io

# Gmail / Google Workspace
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contact@nautix.io
# SMTP_PASSWORD=your-google-app-password
# (Generate at: myaccount.google.com → Security → App Passwords)

# MilesWeb / cPanel hosting
# SMTP_HOST=mail.nautix.io
# SMTP_PORT=587
# SMTP_USER=contact@nautix.io
# SMTP_PASSWORD=your-cpanel-email-password

# Zoho Mail
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=contact@nautix.io
# SMTP_PASSWORD=your-zoho-password

# SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ── Uploads ───────────────────────────────────────────────────────────────────
# Number of days to retain uploaded files before automatic cleanup.
# Defaults to 30 if not set.
UPLOAD_MAX_AGE_DAYS=30
