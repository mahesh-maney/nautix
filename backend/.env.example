# ── Email notification settings ──────────────────────────────────────────────
# All enquiries submitted via the contact form are sent to NOTIFY_EMAIL.

NOTIFY_EMAIL=contact@nautix.com

# Gmail / Google Workspace
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contact@nautix.com
# SMTP_PASSWORD=your-google-app-password
# (Generate at: myaccount.google.com → Security → App Passwords)

# MilesWeb email hosting
# SMTP_HOST=mail.nautix.com
# SMTP_PORT=587
# SMTP_USER=contact@nautix.com
# SMTP_PASSWORD=your-milesweb-email-password

# Zoho Mail
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=contact@nautix.com
# SMTP_PASSWORD=your-zoho-password
