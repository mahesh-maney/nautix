# ── EmailJS (contact form) ─────────────────────────────────────────────────────
# Sign up at https://www.emailjs.com — free tier: 200 emails/month
#
# Steps:
#  1. Create an Email Service (Gmail, Outlook, etc.) → copy the Service ID
#  2. Create an Email Template → copy the Template ID
#     Template variables available: from_name, from_company, reply_to,
#     requirement_type, requirement, attachment_name, attachment_content
#  3. Go to Account → API Keys → copy your Public Key

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
